#Problem 9

# a+b+c = 1000
# find product of abc
# a**2 + b**2 = c**2
# a<b<c

def main():
    for a in range(20,400):
        for b in range(a+1,500):
            c = 1000 - b - a
            if a**2 + b**2 == c**2:
                print(a,b,c)
                print(a*b*c)

if __name__ == "__main__":
    main()
