#Problem 5

num = 2520
div = False

def divisble(num):
    for i in range(1,21):
        if num % i  != 0:
            div = False
            break
        else:
            div = True
    return div
        
while not div:
    div = divisble(num)
    if div:
        print(num)
    else:
        num += 120
