def palindromic_num(n):
    ans = True
    n = str(n)
    for i in range(3):
        if n[i] != n[5-i]:
            ans = False
    return ans


largest = 0
for i in range(990,900,-11):
    for y in range(999,900,-1):
        a = i * y
        if palindromic_num(a) and largest < a:
            largest = a
        elif largest > a:
            break
        
print(largest)
